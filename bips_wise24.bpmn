    <bpmn:participant id="Participant_1lv6edr" processRef="bips_wise24" />
    <bpmn:textAnnotation id="TextAnnotation_16kwl95">
      <bpmn:text>Nur ID und Beschreibung</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1fr6f92">
      <bpmn:text>Prüft, ob ein Lieferant schon im Projekt ist</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_11oy7u1">
      <bpmn:text>Mit Auswahl ob Gewichte angepasst werden sollen</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1r8psj5">
      <bpmn:text>Nur ID und Beschreibung</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1qyydnx">
      <bpmn:text>z. B. -1 wenn neu angelegt werden soll</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0flii58">
      <bpmn:text>Projekt auswahlen为空</bpmn:text>
    </bpmn:textAnnotation>
